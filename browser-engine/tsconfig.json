{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "WebWorker"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@routex/shared/*": ["shared/*"],
      "@routex/engine/*": ["engine/*"],
      "@routex/worker/*": ["worker/*"]
    }
  },
  "include": ["engine/**/*", "shared/**/*", "worker/**/*"],
  "exclude": ["node_modules", "dist"]
}