# ============================================================
# RouteX — Environment Variables (example)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# --- Database ---
# PostgreSQL (Docker / production)
DATABASE_URL=postgresql://routex:routex@localhost:5432/routex
# Local development fallback (no Docker required) — uncomment to use:
# DATABASE_URL=sqlite:///./routex.db

# --- API server ---
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI (optional, disabled by default — do not make mandatory) ---
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
